<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:BoDraw="clr-namespace:BoDraw;assembly=BoDraw"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="steel_hall_ui.MainWindow"
        Title="steel_hall_ui">

    <DockPanel HorizontalSpacing="10" VerticalSpacing="5" Margin="5">

        <Grid
            DockPanel.Dock="Left"
            VerticalAlignment="Top"
            RowDefinitions="*,*,*,*,*,*,*,*" ColumnDefinitions="*, Auto"
            ColumnSpacing="5" RowSpacing="5"
            >

            <Grid.Styles>
                <Style Selector="Label">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="Width" Value="150" />
                </Style>
                <Style Selector="ComboBox">
                    <Setter Property="Width" Value="150" />
                </Style>
            </Grid.Styles>

            <Label Grid.Row="0" Grid.Column="0">Project</Label>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProjectTB">Testprojekt</TextBox>

            <Label Grid.Row="1" Grid.Column="0">Frames</Label>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NumberOfFramesTB">9</TextBox>

            <Label Grid.Row="2" Grid.Column="0">Span</Label>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SpanTB">15.0</TextBox>

            <Label Grid.Row="3" Grid.Column="0">Height</Label>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="HeightTB">4.0</TextBox>

            <Label Grid.Row="4" Grid.Column="0">Spacing</Label>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="FrameSpacingTB">6.0</TextBox>

            <Label Grid.Row="5" Grid.Column="0">Roof Pitch</Label>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="RoofPitchTB">5.0</TextBox>

            <Label Grid.Row="6" Grid.Column="0">Columns</Label>
            <ComboBox Grid.Row="6" Grid.Column="1" SelectedIndex="3" x:Name="ProfileColumnsCoBo">
                <x:String>HE-A 140</x:String>
                <x:String>HE-A 160</x:String>
                <x:String>HE-A 180</x:String>
                <x:String>HE-A 200</x:String>
                <x:String>HE-A 220</x:String>
                <x:String>HE-A 240</x:String>
                <x:String>HE-A 260</x:String>
                <x:String>HE-A 280</x:String>
                <x:String>HE-A 300</x:String>
                <x:String>HE-A 320</x:String>
                <x:String>HE-A 340</x:String>
                <x:String>HE-A 360</x:String>
                <x:String>HE-A 400</x:String>
            </ComboBox>

            <Label Grid.Row="7" Grid.Column="0">Beams</Label>
            <ComboBox Grid.Row="7" Grid.Column="1" SelectedIndex="3" x:Name="ProfileBeamsCoBo">
                <x:String>IPE 200</x:String>
                <x:String>IPE 220</x:String>
                <x:String>IPE 240</x:String>
                <x:String>IPE 270</x:String>
                <x:String>IPE 300</x:String>
                <x:String>IPE 330</x:String>
                <x:String>IPE 360</x:String>
                <x:String>IPE 400</x:String>
                <x:String>IPE 450</x:String>
                <x:String>IPE 500</x:String>
                <x:String>IPE 550</x:String>
            </ComboBox>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Click="OnPlotClick">Plot</Button>
            <Button Click="OnExitClick">Exit</Button>
        </StackPanel>

        <Border BorderBrush="gray" BorderThickness="2">
            <BoDraw:BoDrawCanvas x:Name="Canvas"/>
        </Border>
    </DockPanel>
</Window>
