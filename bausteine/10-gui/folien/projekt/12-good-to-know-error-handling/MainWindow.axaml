<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="good_to_know_error_handling.MainWindow"
        Width="250" SizeToContent="Height"
        Title="Error Handling">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock>Load in kN/m</TextBlock>
        <TextBox x:Name="LoadTB">12.5</TextBox>
        <TextBlock x:Name="ResultTBl"></TextBlock>
        <Button x:Name="ComputeB">Compute</Button>
    </StackPanel>
</Window>
