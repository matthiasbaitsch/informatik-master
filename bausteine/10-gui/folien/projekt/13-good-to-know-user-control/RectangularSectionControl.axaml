<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="good_to_know_user_control.RectangularSectionControl">
  <Grid RowDefinitions="*,*" ColumnDefinitions="Auto,*"
        RowSpacing="5" ColumnSpacing="5">
    <Grid.Styles><Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style></Grid.Styles>
    <TextBlock Grid.Row="0" Grid.Column="0">Width</TextBlock>
    <TextBox x:Name="WidthTB" Grid.Row="0" Grid.Column="1">20</TextBox>
    <TextBlock Grid.Row="1" Grid.Column="0">Height</TextBlock>
    <TextBox x:Name="HeightTB" Grid.Row="1" Grid.Column="1">60</TextBox>
  </Grid>
</UserControl>
