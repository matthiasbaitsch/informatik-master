<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="layout_controls_adjustment.MainWindow"
        Width="250" SizeToContent="Height"
        Title="Adjusting Layouts">
    <StackPanel Margin="20" Spacing="5">
        <Button HorizontalAlignment="Left">Button A</Button>
        <Button HorizontalAlignment="Center">Button B</Button>
        <Button HorizontalAlignment="Right">Button C</Button>
        <Button HorizontalAlignment="Stretch">Button D</Button>
    </StackPanel>
</Window>
