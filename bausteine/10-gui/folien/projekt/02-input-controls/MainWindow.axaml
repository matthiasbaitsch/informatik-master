<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="input_controls.MainWindow"
        Width="250" SizeToContent="Height"
        Title="Controls zur Eingabe">
    <StackPanel Margin="20" Spacing="5">
        <Button>Button</Button>
        <CheckBox>Checkbox</CheckBox>
        <ComboBox SelectedIndex="0">
            <ComboBoxItem>ComboBox A</ComboBoxItem>
            <ComboBoxItem>ComboBox B</ComboBoxItem>
        </ComboBox>
        <NumericUpDown Minimum="0" Maximum="10" Increment="0.5" Value="2.5"/>
        <RadioButton GroupName="rbg1">Radio Atlantic</RadioButton>
        <RadioButton GroupName="rbg1">Radio Paradise</RadioButton>
        <RadioButton GroupName="rbg1">Radio Regenbogen</RadioButton>        
        <Slider Minimum="0" Maximum="100" Value="20"></Slider>
        <TextBox>TextBox</TextBox>
    </StackPanel>
</Window>
