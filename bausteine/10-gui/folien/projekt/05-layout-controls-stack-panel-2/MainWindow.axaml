<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="layout_controls_stack_panel_2.MainWindow"
        Width="250" SizeToContent="Height" Title="Layout mit StackPanel">
    <StackPanel Orientation="Horizontal" Margin="20" Spacing="5">
        <Button>Start</Button>
        <Button>Stop</Button>
        <Button>Exit</Button>
    </StackPanel>
</Window>
