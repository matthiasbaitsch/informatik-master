<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="output_controls.MainWindow"
        Width="250" SizeToContent="Height"
        Title="Output Controls">
    <StackPanel Margin="20" Spacing="30">
        <Image Source="/Assets/hs-bo_logo.png" Width="200"></Image>
        <TextBlock>Simple text block</TextBlock>
        <TextBlock Foreground="Red">Simple text block with color</TextBlock>
        <TextBlock TextWrapping="Wrap" Width="200">
            Multi-line text block: <LineBreak/>
            The glass is <Bold>half full</Bold> and <LineBreak/>
            <Run Foreground="DarkSlateBlue" FontWeight="Bold">things are far better</Run><LineBreak/>
            than many <Italic>pessimists</Italic> think.
        </TextBlock>
    </StackPanel>
</Window>
